# The Logbook System
# Applies when: The resolved SynologyDrive root contains the expected Archives.
alias dly='cd "$SYNOLOGY_DRIVE_ROOT/Archives/Daily Log/$(date +%Y)/" && vi "$(date +%-m).md"'
alias rt='python "$SYNOLOGY_DRIVE_ROOT/Archives/Routine/routine_watcher.py"'
alias fp='python "$SYNOLOGY_DRIVE_ROOT/Archives/fireplace/fireplace_watcher.py"'
alias humans='python "$SYNOLOGY_DRIVE_ROOT/Archives/humans/humans_watcher.py"'
alias archives='python "$SYNOLOGY_DRIVE_ROOT/Archives/archives_watcher.py"'

lab() {
  local research_root="$SYNOLOGY_DRIVE_ROOT/1. Research/Active"
  local dirs choice dir

  dirs=(${(f)"$(find "$research_root" -mindepth 1 -maxdepth 2 -type d -name notes \
    | sed "s#^$research_root/##" \
    | sort)"})

  (( ${#dirs[@]} )) || { echo "No notes directories found under $research_root" >&2; return 1; }

  printf '%s\n' "Lab notes:"
  for i in {1..${#dirs[@]}}; do
    printf '%d  %s\n' "$i" "$dirs[$i]"
  done

  printf 'Select 1-%d, or q to cancel: ' "${#dirs[@]}"
  IFS= read -r choice

  [[ "$choice" == q ]] && return
  [[ "$choice" == <-> ]] || return 1
  (( choice >= 1 && choice <= ${#dirs[@]} )) || return 1

  dir="$dirs[$choice]"
  [ -n "$dir" ] && (cd "$research_root/$dir" && vim notes.md)
}

toy() {
  pushd "$SYNOLOGY_DRIVE_ROOT/Archives/tomorrow-of-yesterday" > /dev/null || return 1
  ./venv/bin/python main.py
  local rc=$?
  popd > /dev/null 2>&1
  return $rc
}

vpn() {
  local vpn_bin="/opt/cisco/secureclient/bin/vpn"
  local host="cuvpn.cuvpn.cornell.edu"
  local cmd="${1:-}"

  case "$cmd" in
    check|status)
      # Let Cisco handle its interactive prompt.
      "$vpn_bin" stats
      ;;
    connect|up)
      "$vpn_bin" connect "$host"
      ;;
    terminate|kill|reset)
      echo "Terminating Cisco Secure Client / vpn processes..."
      osascript -e 'quit app "Cisco Secure Client"' >/dev/null 2>&1 || true
      pkill -f "Cisco Secure Client" >/dev/null 2>&1 || true
      pkill -f "/opt/cisco/secureclient/bin/vpn" >/dev/null 2>&1 || true
      pkill -f "Cisco Secure Client.*vpn" >/dev/null 2>&1 || true
      pgrep -af "Cisco|secureclient|/opt/cisco/secureclient/bin/vpn" || echo "No matching Cisco/vpn processes remain."
      ;;
    ""|help|-h|--help)
      cat <<'EOF'
Usage: vpn [check|connect|terminate]
  vpn check       Run Cisco VPN stats directly; includes duration/expiry when Cisco reports it
  vpn connect     Connect to cuvpn.cuvpn.cornell.edu
  vpn terminate   Quit/kill Cisco Secure Client and vpn CLI instances
EOF
      ;;
    *)
      echo "Unknown vpn command: $cmd" >&2
      echo "Usage: vpn [check|connect|terminate]" >&2
      return 2
      ;;
  esac
}

vpnfix() {
  sudo dscacheutil -flushcache
  sudo killall -HUP mDNSResponder
}
