# ==============================================================================
# !!!!!! CONDA VIM WRAPPER — BEGIN !!!!!!
# Applies when: Vim cannot be installed system-wide and Conda is available.
# Conda-backed Vim fallback for restricted machines.
# ==============================================================================

# Install Vim in the active Conda environment when needed.
vim() {
  if conda list | grep -q "^vim "; then
    command vim "$@"
  else
    echo "vim not found in current conda env: installing..."
    conda install -y vim
    command vim "$@"
  fi
}

# ==============================================================================
# !!!!!! CONDA GPUSTAT WRAPPER — BEGIN !!!!!!
# Applies when: CUDA and Conda are available and no usable global gpustat exists.
# Conda-backed gpustat fallback for restricted machines.
# ==============================================================================

gpustat() {
  if conda list | grep -q "^gpustat "; then
    command gpustat "$@"
  else
    echo "gpustat not found in current conda env: installing..."
    conda install -y gpustat
    command gpustat "$@"
  fi
}

# ==============================================================================
# !!!!!! YGGDRASIL — BEGIN !!!!!!
# Applies when: The machine is a Linux server. Do not use this section on macOS.
# Yggdrasil mount controls.
# ==============================================================================

ygg() {
  if mountpoint -q "$HOME/yggdrasil"; then
    echo "Yggdrasil already mounted"
    return 0
  fi

  mkdir -p "$HOME/yggdrasil" "$HOME/.cache"

  nohup rclone mount yggdrasil:syphon-yggdrasil "$HOME/yggdrasil" \
    --links \
    --vfs-fast-fingerprint \
    --vfs-cache-mode full \
    --file-perms 0775 \
    --dir-perms 0775 \
    --umask 0000 \
    --vfs-cache-max-age 60d \
    --rc \
    --rc-no-auth \
    --rc-addr 127.0.0.1:5572 \
    >"$HOME/.cache/yggdrasil-rclone.log" 2>&1 &!

  # Remote initialization may take several seconds, so poll for up to 30 seconds.
  local attempt
  for attempt in {1..30}; do
    if mountpoint -q "$HOME/yggdrasil"; then
      echo "Yggdrasil mounted at ~/yggdrasil"
      return 0
    fi
    sleep 1
  done

  echo "Yggdrasil mount failed after 30 seconds"
  return 1
}

yggstat() {
  if ! mountpoint -q "$HOME/yggdrasil"; then
    echo "Yggdrasil is not mounted"
    return 1
  fi

  local queue stats vfs_stats
  local queued uploads_queued uploads_active cache_errors cache_in_use cache_out_of_space
  local active_transfers active_checks historical_errors fatal_error retry_error
  local mount_user_pids="unavailable"
  local mount_users="unavailable"

  # These RC responses are a best-effort snapshot. Rclone does not expose one
  # atomic idle state covering FUSE users, transfers, uploads, and renames.
  queue="$(rclone rc vfs/queue)" || return 1
  stats="$(rclone rc core/stats)" || return 1
  vfs_stats="$(rclone rc vfs/stats)" || return 1
  queued="$(printf '%s' "$queue" | python3 -c 'import json, sys; print(len(json.load(sys.stdin)["queue"]))')" || return 1
  read -r active_transfers active_checks historical_errors fatal_error retry_error <<<"$(
    printf '%s' "$stats" |
      python3 -c 'import json, sys; s = json.load(sys.stdin); print(len(s.get("transferring", [])), len(s.get("checking", [])), int(s.get("errors", 0)), int(bool(s.get("fatalError", False))), int(bool(s.get("retryError", False))))'
  )" || return 1
  read -r uploads_queued uploads_active cache_errors cache_in_use cache_out_of_space <<<"$(
    printf '%s' "$vfs_stats" |
      python3 -c 'import json, sys; s = json.load(sys.stdin); d = s["diskCache"]; print(int(d["uploadsQueued"]), int(d["uploadsInProgress"]), int(d["erroredFiles"]), int(s["inUse"]), int(bool(d["outOfSpace"])))'
  )" || return 1

  # FUSE users catch operations that need not appear as byte transfers, such
  # as a process whose working directory or open file is inside the mount.
  if command -v fuser >/dev/null 2>&1; then
    mount_user_pids="$(fuser -m "$HOME/yggdrasil" 2>/dev/null | xargs)"
    mount_users="$(printf '%s\n' "$mount_user_pids" | awk '{ print NF }')"
  fi

  echo "Yggdrasil activity snapshot (some counters may overlap):"
  echo "  VFS queue entries:       $queued"
  echo "  uploads queued:          $uploads_queued"
  echo "  uploads in progress:     $uploads_active"
  echo "  active transfers:        $active_transfers"
  echo "  active checks:           $active_checks"
  echo "  cache files with errors: $cache_errors"
  echo "  cache entries in use:    $cache_in_use"
  echo "  cache out of space:      $cache_out_of_space"
  echo "  processes using mount:   $mount_users"
  if [[ "$mount_user_pids" != "unavailable" && -n "$mount_user_pids" ]]; then
    echo "  mount-user PIDs:         $mount_user_pids"
  fi
  echo "  historical errors:       $historical_errors"
  echo "  sticky fatal/retry:      $fatal_error/$retry_error"
  echo
}

yggrefresh() {
  rclone rc vfs/forget >/dev/null &&
    echo "Yggdrasil refreshed"
}

yggoff() {
  local force=0
  if (( $# > 1 )); then
    echo "Usage: yggoff [--force]"
    return 2
  fi
  if (( $# == 1 )); then
    if [[ "$1" != "--force" ]]; then
      echo "Usage: yggoff [--force]"
      return 2
    fi
    force=1
  fi

  if ! mountpoint -q "$HOME/yggdrasil"; then
    echo "Yggdrasil is not mounted"
    return 0
  fi

  if (( force )); then
    local pid_json pid answer
    echo "Run yggstat manually and review its activity snapshot before confirming."
    echo "Forced unmount can interrupt reads, writes, or metadata operations."
    printf "Force unmount anyway? [y/N] "
    if ! read -r answer; then
      echo
      echo "Forced unmount cancelled"
      return 1
    fi
    case "$answer" in
      y|Y|yes|YES)
        ;;
      *)
        echo "Forced unmount cancelled"
        return 1
        ;;
    esac

    pid_json="$(rclone rc core/pid)" || return 1
    pid="$(printf '%s' "$pid_json" | python3 -c 'import json, sys; print(int(json.load(sys.stdin)["pid"]))')" || return 1
    rclone rc core/quit >/dev/null || return 1
    local attempt
    for attempt in {1..3}; do
      if ! kill -0 "$pid" 2>/dev/null &&
          ! findmnt -rn -M "$HOME/yggdrasil" >/dev/null; then
        echo "Yggdrasil unmounted"
        return 0
      fi
      sleep 1
    done

    if findmnt -rn -M "$HOME/yggdrasil" >/dev/null; then
      if command -v fusermount3 >/dev/null 2>&1; then
        fusermount3 -uz "$HOME/yggdrasil" || return 1
      elif command -v fusermount >/dev/null 2>&1; then
        fusermount -uz "$HOME/yggdrasil" || return 1
      else
        umount -l "$HOME/yggdrasil" || return 1
      fi
    fi

    for attempt in {1..10}; do
      if ! kill -0 "$pid" 2>/dev/null &&
          ! findmnt -rn -M "$HOME/yggdrasil" >/dev/null; then
        echo "Yggdrasil force-unmounted"
        return 0
      fi
      sleep 1
    done

    echo "Yggdrasil forced shutdown failed: process or mount is still present"
    return 1
  fi

  if command -v fusermount3 >/dev/null 2>&1; then
    fusermount3 -u "$HOME/yggdrasil" || return 1
  elif command -v fusermount >/dev/null 2>&1; then
    fusermount -u "$HOME/yggdrasil" || return 1
  else
    umount "$HOME/yggdrasil" || return 1
  fi

  echo "Yggdrasil unmounted"
}

yggcache() {
  local mount="$HOME/yggdrasil"
  local cache_root
  local rel=""
  local line cmd arg
  local here target size answer oldpwd
  local restore_pwd

  if ! mountpoint -q "$mount"; then
    echo "Yggdrasil is not mounted"
    return 1
  fi

  if ! rclone rc vfs/stats >/dev/null 2>&1; then
    echo "Yggdrasil RC is not available"
    return 1
  fi

  cache_root="$(
    rclone rc vfs/stats |
      python3 -c 'import json,sys; print(json.load(sys.stdin)["diskCache"]["path"])'
  )" || return 1

  if (( $+functions[_yggcache_list] || $+functions[_yggcache_complete] ||
        $+widgets[yggcache-complete] )); then
    echo "yggcache helper name collision" >&2
    return 1
  fi

  _yggcache_complete() {
    local command="${BUFFER%% *}"
    local -a candidates

    if [[ "$BUFFER" != *" "* ]]; then
      candidates=(cd ls purge help q)
    else
      case "$command" in
        cd)
          candidates=("$here"/*(/N:t))
          ;;
        purge)
          candidates=("$here"/*(N:t))
          ;;
      esac
    fi

    (( ${#candidates[@]} )) && compadd -a candidates
  }

  zle -C yggcache-complete complete-word _yggcache_complete
  bindkey -N yggcache main
  bindkey -M yggcache '^I' yggcache-complete

  _yggcache_list() {
    here="$cache_root"
    [[ -n "$rel" ]] && here="$cache_root/$rel"

    printf 'Yggdrasil cache: /%s\n\n' "$rel"

    python3 - "$here" <<'PY'
import os
import sys

root = sys.argv[1]

def usage(path):
    total = 0

    def add(p):
        nonlocal total
        try:
            total += os.lstat(p).st_blocks * 512
        except FileNotFoundError:
            pass

    add(path)

    if os.path.isdir(path):
        for base, dirs, files in os.walk(path):
            for name in dirs:
                add(os.path.join(base, name))
            for name in files:
                add(os.path.join(base, name))

    return total

def human(n):
    units = ["B", "KiB", "MiB", "GiB", "TiB"]
    value = float(n)

    for unit in units:
        if value < 1024 or unit == units[-1]:
            return f"{value:7.1f} {unit}"
        value /= 1024

try:
    entries = list(os.scandir(root))
except FileNotFoundError:
    print("Cache directory disappeared")
    sys.exit(1)

items = []

for entry in entries:
    size = usage(entry.path)
    items.append(
        (
            size,
            entry.is_dir(follow_symlinks=False),
            entry.name,
        )
    )

items.sort(reverse=True)

for size, is_dir, name in items:
    marker = "/" if is_dir else ""
    print(f"{human(size)}   {name}{marker}")

print()
print(f"Total: {human(usage(root))}")
PY

    echo
  }

  {
    _yggcache_list

    while true; do
      line=""
      vared -M yggcache -p "yggcache:/$rel> " line || return 0

    [[ -z "$line" ]] && continue

    cmd="${line%% *}"

    if [[ "$line" == *" "* ]]; then
      arg="${line#* }"
    else
      arg=""
    fi

    case "$cmd" in
      q|quit)
        return 0
        ;;

      cd)
        if [[ "$arg" == ".." ]]; then
          if [[ -n "$rel" ]]; then
            rel="${rel:h}"
            [[ "$rel" == "." ]] && rel=""
            _yggcache_list
          fi
          continue
        fi

        if [[ -z "$arg" || "$arg" == "." || "$arg" == */* ]]; then
          echo "Use: cd <visible-directory>"
          continue
        fi

        if [[ -d "$here/$arg" ]]; then
          rel="${rel:+$rel/}$arg"
          _yggcache_list
        else
          echo "Not a cached directory: $arg"
        fi
        ;;

      ls)
        _yggcache_list
        ;;

      purge)
        if [[ -z "$arg" || "$arg" == "." || "$arg" == ".." || "$arg" == */* ]]; then
          echo "Use: purge <visible-entry>"
          continue
        fi

        target="$here/$arg"

        if [[ ! -e "$target" ]]; then
          echo "Not cached: $arg"
          continue
        fi

        size="$(
          python3 - "$target" <<'PY'
import os
import sys

path = sys.argv[1]
total = 0

def add(p):
    global total
    try:
        total += os.lstat(p).st_blocks * 512
    except FileNotFoundError:
        pass

add(path)

if os.path.isdir(path):
    for base, dirs, files in os.walk(path):
        for name in dirs:
            add(os.path.join(base, name))
        for name in files:
            add(os.path.join(base, name))

units = ["B", "KiB", "MiB", "GiB", "TiB"]
value = float(total)

for unit in units:
    if value < 1024 or unit == units[-1]:
        print(f"{value:.1f} {unit}")
        break
    value /= 1024
PY
        )"

        echo
        echo "Evict LOCAL cache only:"
        echo "  /${rel:+$rel/}$arg"
        echo "  $size"
        echo
        echo "The Backblaze copy will NOT be deleted."
        printf "Continue? [y/N] "

        read -r answer

        [[ "$answer" == [yY] ]] || continue

        oldpwd="$PWD"
        restore_pwd=0

        if [[ "$PWD" == "$mount" || "$PWD" == "$mount/"* ]]; then
          cd "$HOME" || return 1
          restore_pwd=1
        fi

        if ! yggoff; then
          echo "Cannot purge while uploads are pending"

          if (( restore_pwd )); then
            cd "$oldpwd" 2>/dev/null || true
          fi

          continue
        fi

        rm -rf -- "$target" || return 1

        ygg || return 1

        if (( restore_pwd )); then
          cd "$oldpwd" 2>/dev/null || cd "$mount"
        fi

        cache_root="$(
          rclone rc vfs/stats |
            python3 -c 'import json,sys; print(json.load(sys.stdin)["diskCache"]["path"])'
        )" || return 1

        echo "Evicted $arg ($size)"
        _yggcache_list
        ;;

      help|h|\?)
        echo "Commands:"
        echo "  cd <dir>       enter a cached directory"
        echo "  cd ..          go up one directory"
        echo "  ls             list the current directory"
        echo "  purge <entry>  evict a visible file or directory"
        echo "  q              quit"
        ;;

      *)
        echo "Commands: cd <dir>, cd .., ls, purge <entry>, q"
        ;;
    esac
    done
  } always {
    bindkey -D yggcache
    zle -D yggcache-complete
    unfunction _yggcache_complete _yggcache_list
  }
}

