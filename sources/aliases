# ==============================================================================
# !!!!!! SLURM — BEGIN !!!!!!
# Applies when: The machine is a Slurm node.
# Slurm job and cluster controls.
# ==============================================================================

# Attach to the first running job in Slurm
sa() {
  jid=$(squeue -u "$USER" --states=R -h -o "%A" | head -n1)
  [ -n "$jid" ] && srun --jobid="$jid" --pty --overlap zsh || echo "No RUNNING jobs."
}

